[
  {
    "name": "02 - Verificacion de backup",
    "active": true,
    "settings": {
      "executionOrder": "v1"
    },
    "nodes": [
      {
        "parameters": {},
        "id": "a2000000-0000-4000-8000-000000000001",
        "name": "Ejecutar a mano",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [
          -220,
          0
        ]
      },
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "days",
                "daysInterval": 1,
                "triggerAtHour": 3,
                "triggerAtMinute": 0
              }
            ]
          }
        },
        "id": "a2000000-0000-4000-8000-000000000002",
        "name": "Cron diario",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          -220,
          160
        ]
      },
      {
        "parameters": {
          "command": "stat -c \"%Y %s %n\" /backups/*.sql.gz | sort -n | tail -1"
        },
        "id": "a2000000-0000-4000-8000-000000000003",
        "name": "Estado del backup",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          20,
          0
        ]
      },
      {
        "parameters": {
          "jsCode": "// Evalua el backup mas reciente: edad y tamano.\n// El backup lo genera scripts/backup.ps1 (Programador de tareas de Windows);\n// este flujo verifica que exista, que sea reciente y que no este vacio.\nconst bruto = ($json.stdout || '').trim();\n\nif (!bruto) {\n  return [{ json: { ok: false, motivo: 'no hay ningun archivo .sql.gz en /backups', edadHoras: null, tamMB: 0, ruta: null } }];\n}\n\nconst partes = bruto.split(/\\s+/);\nconst epoch = Number(partes[0]);\nconst bytes = Number(partes[1]);\nconst ruta = partes.slice(2).join(' ');\n\nconst maxHoras = Number($env.BACKUP_MAX_HORAS || 26);\nconst minMB = Number($env.BACKUP_MIN_MB || 1);\n\nconst edadHoras = (Date.now() / 1000 - epoch) / 3600;\nconst tamMB = bytes / 1024 / 1024;\n\nconst problemas = [];\nif (!(edadHoras <= maxHoras)) problemas.push(`tiene ${edadHoras.toFixed(1)} h (maximo ${maxHoras})`);\nif (!(tamMB >= minMB)) problemas.push(`pesa ${tamMB.toFixed(2)} MB (minimo ${minMB})`);\n\nreturn [{\n  json: {\n    ok: problemas.length === 0,\n    motivo: problemas.length === 0 ? 'backup vigente' : problemas.join(' y '),\n    edadHoras: Number(edadHoras.toFixed(1)),\n    tamMB: Number(tamMB.toFixed(1)),\n    ruta,\n  },\n}];"
        },
        "id": "a2000000-0000-4000-8000-000000000004",
        "name": "Evaluar backup",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose",
              "version": 2
            },
            "conditions": [
              {
                "id": "cond-1",
                "leftValue": "={{ $json.ok }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "a2000000-0000-4000-8000-000000000005",
        "name": "Backup vigente?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          500,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://mantis/api/rest/issues",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "__MANTIS_TOKEN__"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ summary: 'Backup vencido o invalido: ' + $json.motivo, description: 'El flujo 02 de n8n no encontro un backup valido.\\n\\nMotivo: ' + $json.motivo + '\\nArchivo: ' + ($json.ruta || 'ninguno') + '\\nEdad: ' + ($json.edadHoras === null ? 'sin dato' : $json.edadHoras + ' h') + '\\nTamano: ' + $json.tamMB + ' MB', category: { name: 'Infraestructura' }, project: { id: 1 }, severity: { name: 'major' }, priority: { name: 'urgent' } }) }}",
          "options": {
            "timeout": 15000
          }
        },
        "id": "a2000000-0000-4000-8000-000000000006",
        "name": "Crear issue en Mantis",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          740,
          120
        ]
      },
      {
        "parameters": {},
        "id": "a2000000-0000-4000-8000-000000000007",
        "name": "Sin accion",
        "type": "n8n-nodes-base.noOp",
        "typeVersion": 1,
        "position": [
          740,
          -100
        ]
      }
    ],
    "connections": {
      "Ejecutar a mano": {
        "main": [
          [
            {
              "node": "Estado del backup",
              "type": "main",
