    },
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "incidente",
          "responseMode": "responseNode",
          "options": {
            "rawBody": false
          }
        },
        "id": "b4000000-0000-4000-8000-000000000001",
        "name": "Webhook incidente",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "webhookId": "incidente"
      },
      {
        "parameters": {
          "jsCode": "// Valida el mismo token que el flujo de Mantis y normaliza el payload.\n// __WEBHOOK_TOKEN__ lo reemplaza el entrypoint desde .env.\nconst h = $json.headers || {};\nconst header = (name) => {\n  const k = Object.keys(h).find((key) => key.toLowerCase() === name.toLowerCase());\n  return k ? h[k] : undefined;\n};\nconst esperado = '__WEBHOOK_TOKEN__';\nconst recibido = header('x-webhook-token');\nconst auth = header('authorization') || '';\nconst bearer = auth.toLowerCase().startsWith('bearer ') ? auth.slice(7) : '';\nconst autorizado = esperado.indexOf('__') === -1 && (recibido === esperado || bearer === esperado);\n\nconst cuerpo = $json.body || {};\nconst alertas = Array.isArray(cuerpo.alerts) ? cuerpo.alerts : [];\nconst valido = alertas.length > 0 && !!cuerpo.status;\n\nreturn [{\n  json: {\n    autorizado,\n    valido,\n    codigo: !autorizado ? 401 : 400,\n    motivo: !autorizado ? 'token invalido o ausente' : 'payload invalido: falta status o alerts',\n    alerta: cuerpo,\n  },\n}];"
        },
        "id": "b4000000-0000-4000-8000-000000000002",
        "name": "Validar token y payload",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose",
              "version": 2
            },
            "conditions": [
              {
                "id": "cond-1",
                "leftValue": "={{ $json.autorizado && $json.valido }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "b4000000-0000-4000-8000-000000000003",
        "name": "Peticion valida?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          440,
          0
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://mcp:8080/incidentes",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "Bearer __MCP_TOKEN__"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ alerta: $json.alerta }) }}",
          "options": {
            "timeout": 15000
          }
        },
        "id": "b4000000-0000-4000-8000-000000000004",
        "name": "Registrar incidente",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          680,
          -100
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ ok: true, incidente: $json.incidente || null, error: $json.error || null }) }}",
          "options": {}
        },
        "id": "b4000000-0000-4000-8000-000000000005",
        "name": "Responder 200",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          920,
          -100
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ ok: false, error: $json.motivo || 'peticion invalida' }) }}",
          "options": {
            "responseCode": 401
          }
        },
        "id": "b4000000-0000-4000-8000-000000000006",
        "name": "Responder error",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          680,
          120
        ]
      }
    ],
