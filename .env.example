# ============================================================
# Plantilla de variables de entorno
# Copiar a .env y completar.  .env NUNCA se versiona.
#   cp .env.example .env
# ============================================================

# --- PostgreSQL: primaria ---
POSTGRES_DB=practica
POSTGRES_USER=practica_app
POSTGRES_PASSWORD=cambiar_en_local

# Puerto publicado SOLO en loopback (127.0.0.1). No se expone a Internet.
DB_PORT=5433

# --- PostgreSQL: réplica (Sprint 3, §6) ---
REPL_USER=replicador
REPL_PASSWORD=cambiar_en_local

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambiar_en_local

# --- Backend / Frontend (Sprint 2, §7) ---
# DATABASE_URL la arma el compose; acá queda para correr fuera de Docker
DATABASE_URL=postgresql://practica_app:cambiar_en_local@localhost:5433/practica
JWT_SECRET=cambiar_en_local_min_32_chars

# --- Volumen del dataset (§4) ---
# 6000000 es el mínimo exigido por el enunciado para tablas de volumen
SEED_ARTICLES=6000000
SEED_COMMENTS=6000000
SEED_FAVORITES=6000000
SEED_USERS=200000
SEED_TAGS=5000
# --- Mantis (§11) ---
MANTIS_DB_NAME=mantis
MANTIS_DB_USER=mantis
MANTIS_DB_PASSWORD=cambiar_en_local
MANTIS_CRYPTO_SALT=cambiar_en_local_min_32_chars
REPL_SUBNET=172.16.0.0/12
# host de la base para el backend (failover manual, §6)
DATABASE_HOST=db

# --- Monitoreo (§10) ---
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=cambiame
GRAFANA_ADMIN_PASSWORD=cambiame
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# --- Borde de administracion (§9) ---
EDGE_ADMIN_USER=admin
EDGE_ADMIN_PASSWORD=cambiame
