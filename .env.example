# ============================================================
# Plantilla de variables de entorno
# Copiar a .env y completar.  .env NUNCA se versiona.
#   cp .env.example .env
# ============================================================

# --- PostgreSQL: primaria ---
POSTGRES_DB=practica
POSTGRES_USER=practica_app
POSTGRES_PASSWORD=cambiar_en_local

# Puerto publicado SOLO en loopback (127.0.0.1). No se expone a Internet.
DB_PORT=5433

# --- PostgreSQL: réplica (Sprint 3, §6) ---
REPL_USER=replicador
REPL_PASSWORD=cambiar_en_local

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambiar_en_local

# --- Backend / Frontend (Sprint 2, §7) ---
# DATABASE_URL la arma el compose; acá queda para correr fuera de Docker
DATABASE_URL=postgresql://practica_app:cambiar_en_local@localhost:5433/practica
JWT_SECRET=cambiar_en_local_min_32_chars

# --- Volumen del dataset (§4) ---
# 6000000 es el mínimo exigido por el enunciado para tablas de volumen
SEED_ARTICLES=6000000
SEED_COMMENTS=6000000
SEED_FAVORITES=6000000
SEED_USERS=200000
SEED_TAGS=5000
# --- Mantis (§11) ---
MANTIS_DB_NAME=mantis
MANTIS_DB_USER=mantis
MANTIS_DB_PASSWORD=cambiar_en_local
MANTIS_CRYPTO_SALT=cambiar_en_local_min_32_chars
REPL_SUBNET=172.16.0.0/12
# host de la base para el backend (failover manual, §6)
DATABASE_HOST=db

# --- Monitoreo (§10) ---
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=cambiame
GRAFANA_ADMIN_PASSWORD=cambiame
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# --- Borde de administracion (§9) ---
EDGE_ADMIN_USER=admin
EDGE_ADMIN_PASSWORD=cambiame
MANTIS_API_TOKEN=cambiame

# --- n8n (§13) ---
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=cambiame
N8N_WEBHOOK_TOKEN=cambiame

# --- Rol de la aplicacion con privilegios minimos (§14) ---
APP_DB_USER=app
APP_DB_PASSWORD=cambiame

# --- Servidor MCP y agente Hermes (extra) ---
MCP_TOKEN=cambiame-por-un-token-largo
MCP_ALLOW_WRITE=false
MCP_USER_EMAIL=
MCP_USER_PASSWORD=
# --- Incidentes + Hermes (extra) ---
MCP_INCIDENTS_ENABLED=true
OPS_DB_NAME=ops
OPS_DB_USER=mcp_ops
MCP_OPS_DB_PASSWORD=cambiame
# correo de la demo: MailHog captura, no entrega
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=ops@pi.local
MAIL_TO=operador@pi.local
# Telegram: el bot y el chat que reciben el aviso y la confirmación
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENCODE_GO_API_KEY=
HERMES_DASHBOARD_USER=admin
HERMES_DASHBOARD_PASSWORD=cambiame
HERMES_DASHBOARD_SECRET=cambiame
HERMES_API_KEY=cambiame
# --- Nextcloud (§12) ---
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=cambiame
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=cambiame
NEXTCLOUD_USER_PASSWORD=cambiame

# --- RAGFlow (extra: motor documental) ---
RAGFLOW_API_KEY=cambiame

# --- Telegram (extra) ---
TELEGRAM_BOT_TOKEN=cambiame
TELEGRAM_ALLOWED_USERS=

# --- Jira Data Center local (§2) ---
# Base propia: el esquema de Jira no se mezcla con la base replicada del §6.
JIRA_DB_NAME=jira
JIRA_DB_USER=jira
JIRA_DB_PASSWORD=cambiar_en_local
JIRA_JVM_MIN=1g
JIRA_JVM_MAX=2g
# vacios en local: se llega por 127.0.0.1 o por el tunel
JIRA_PROXY_NAME=
JIRA_PROXY_PORT=

# --- n8n: cuenta owner (extra) ---
N8N_OWNER_EMAIL=admin@hia.local
N8N_OWNER_PASSWORD=cambiame


# --- Taiga local (§2) ---
# Gestor de backlog autoalojado: el tablero vive en el servidor, sin
# licencia y sin depender de un servicio en la nube.
TAIGA_DOMAIN=localhost:8084
TAIGA_SECRET_KEY=cambiar_en_local
TAIGA_DB_USER=taiga
TAIGA_DB_PASSWORD=cambiar_en_local
TAIGA_RABBIT_USER=taiga
TAIGA_RABBIT_PASSWORD=cambiar_en_local
TAIGA_ERLANG_COOKIE=cambiar_en_local
TAIGA_ADMIN_USER=admin
TAIGA_ADMIN_EMAIL=admin@example.com
TAIGA_ADMIN_PASSWORD=cambiar_en_local
